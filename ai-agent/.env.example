# Copy to .env and fill in. Never commit .env.
#
# In Codespaces these are set as repository secrets instead:
#   repo -> Settings -> Secrets and variables -> Codespaces -> New repository secret
# A Codespace must be restarted after adding a secret; they are injected at start.

# --- Database -----------------------------------------------------------
# Spring needs the JDBC form, which is NOT the libpq URL Neon shows you.
# Neon gives:  postgresql://user:pass@ep-xxx.region.aws.neon.tech/fineract_agent?sslmode=require
# Spring wants: jdbc:postgresql://ep-xxx.region.aws.neon.tech/fineract_agent?sslmode=require
#               plus username and password as separate properties.
#
# Derive all three from AGENT_DB_URL:
#   AGENT_DB_JDBC_URL="jdbc:postgresql://$(echo "$AGENT_DB_URL" | sed 's|.*@||')"
#   AGENT_DB_USER=$(echo "$AGENT_DB_URL" | sed 's|.*://||; s|:.*||')
#   AGENT_DB_PASSWORD=$(echo "$AGENT_DB_URL" | sed 's|.*://[^:]*:||; s|@.*||')
AGENT_DB_JDBC_URL=jdbc:postgresql://localhost:5432/fineract_agent?sslmode=require
AGENT_DB_USER=
AGENT_DB_PASSWORD=

# --- Gemini -------------------------------------------------------------
# Developer API key (free tier) from https://aistudio.google.com/api-keys
# This is the Gemini Developer API, not Vertex AI. Do not also set a GCP
# project id or location: either switches Spring AI into Vertex mode, where
# this key is rejected.
GEMINI_API_KEY=
